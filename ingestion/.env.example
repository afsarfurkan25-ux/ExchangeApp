# Supabase gizli anahtarı: Dashboard > Project Settings > API Keys > Secret keys
# sb_secret_... ile başlar. RLS'i baypas eder, ASLA istemciye/repoya girmemeli.
# (Eski projelerde service_role JWT'si; SUPABASE_SERVICE_ROLE_KEY adı da kabul edilir.)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# altinapi.com
ALTINAPI_URL=https://altinapi.com
ALTINAPI_KEY=
ALTINAPI_CATEGORIES=DOVIZ,MADEN,SARRAFIYE,GRAM ALTIN

# ── Zamanlama (hepsi ms) ─────────────────────────────────────────────────────
STALE_MS=60000             # bu süreden eski değer bayat sayılır, yedek kaynağa düşülür
MAX_SPREAD_PCT=5           # bid/ask makası bu yüzdeyi aşarsa satır reddedilir
MAX_JUMP_PCT=15            # önceki değere göre bu orandan fazla sıçrama reddedilir

REST_POLL_MS=3600000       # altinapi REST yoklama sıklığı  >>> TEST: 1 saat <<<  (canlı: 30000)
WRITE_INTERVAL_MS=1000     # live_rates tablosuna yazma sıklığı
RATE_SYNC_MS=5000          # rates tablosuna yazma sıklığı (panolara yansıma hızı)
CONFIG_REFRESH_MS=30000    # marj/kilit/sembol ayarlarının tazelenme sıklığı
STATUS_LOG_MS=60000        # durum özeti logu sıklığı
